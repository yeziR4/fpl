/node_modules

# Vercel's local dev/link state, and local-only env vars for `vercel dev`.
# The real credentials are Vercel project environment variables, never a file.
/.vercel
.env
.env.local

*.tsbuildinfo

# Compiled output for the CLI scripts.
dist/

# Local scratch: the throwaway keypair used for --dry-run shape checks, and any
# spec generated on the fly. Never a real key.
.keygen.mjs
.throwaway-keypair.json
