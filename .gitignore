__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Cached FPL API snapshots build up locally and shouldn't be committed --
# they're regenerated by `fetch-*` and are effectively a local database.
data/cache/*
!data/cache/.gitkeep

# Kane CLI's own local state: sealed evidence packs from each run
# (screenshots, logs, results -- regenerated every run, not source) and
# project context. Test flows themselves (.testmuai/tests/*.md) are
# committed -- see docs/architecture.md, "Verification: Kane CLI".
.testmuai/evidence/
.testmuai/context.md
